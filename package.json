{
  "name": "notion-clone",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "노션과 같은 기능을 하는 웹 앱. TypeScript + Next.js.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "check:licenses": "node scripts/check-licenses.mjs",
    "licenses": "node scripts/check-licenses.mjs --list",
    "check": "npm run typecheck && npm run lint && npm run check:licenses",
    "dc": "node scripts/dc.mjs",
    "db:up": "node scripts/dc.mjs up -d --wait",
    "db:down": "node scripts/dc.mjs down",
    "db:reset": "node scripts/dc.mjs down -v && node scripts/dc.mjs up -d --wait && node scripts/migrate.mjs",
    "db:logs": "node scripts/dc.mjs logs -f db",
    "db:psql": "node scripts/dc.mjs exec db psql -U notion -d notion",
    "db:verify": "node scripts/verify-db.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:status": "node scripts/migrate.mjs --status",
    "db:verify:schema": "node scripts/verify-schema.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
