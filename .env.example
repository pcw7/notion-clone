# 이 파일을 .env 로 복사해서 쓴다.  cp .env.example .env
# .env 는 gitignore 대상이다. 절대 커밋하지 않는다.

# ── 데이터베이스 ────────────────────────────────────────────────
# docker-compose.yml 의 db 서비스 기본값과 맞춰져 있다.
DATABASE_URL="postgresql://notion:notion_dev_only@localhost:5432/notion"

# ── 캐시 (Valkey) ──────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── 앱 ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# 익명 쓰기(공개 신고 · 공개 폼)의 출처 검사는 요청이 닿은 주소와 위의 공개 주소를 받는다. 주소가 더 있으면 쉼표로(10n-78).
# APP_ALLOWED_ORIGINS="https://www.example.com"

# 세션 쿠키 서명 키. 개발용 아무 값이나 두지 말고 아래로 생성해서 넣는다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# ── 협업 서버 (CRDT 동시편집) ──────────────────────────────────
# npm run collab 이 띄운다(Hocuspocus 별도 프로세스). 받는 Origin 은 NEXT_PUBLIC_APP_URL 이다.
COLLAB_PORT="3001"

# ── 메일 ───────────────────────────────────────────────────────
# console = 발송하지 않고 서버 로그에 코드를 출력한다 (개발 전용).
# 운영에서는 반드시 실제 발송기를 지정한다 — 미지정이면 기동 시 실패한다.
MAIL_TRANSPORT="console"

# ── 성능 계측 (F-12-18 · 10e-1b) ────────────────────────────────
# 워크스페이스 화면의 실사용 측정값(웹 바이탈 · 편집기 준비) 표본 비율 — 0~1 · 기본 0.2 · 0 이면 끈다.
# 보고: npm run perf -- [일수]
PERF_SAMPLE_RATE="0.2"

# ── 새 버전 알림 (F-12-17 · 10h-1) ──────────────────────────────
# 지금 배포의 표지(영숫자 · . _ - 64자) — 배포가 준다(예: git 커밋). 비우면 빌드의 .next/BUILD_ID 를 쓴다.
# 워크스페이스 화면이 /api/release 로 묻고, 문서가 실려 온 표지와 다르면 "새 버전이 있습니다" 띠를 세운다.
# APP_RELEASE=""

# ── AI (AI-1 · F-10-12) ────────────────────────────────────────
# 정본 §3.10 [보강 AI-1]. OpenAI 호환 Chat Completions 하나 — 주소 · 키 · 모델 셋 중 하나라도 비면 AI 는 꺼진 것과 같다
# (화면: "운영자가 AI 를 설정하지 않았습니다"). 외부 AI 는 **무료 등급만 · 카드를 등록하지 않는다**(돈이 나갈 길이 없다).
# CLAUDE.md 절대 제약 2: 한도는 "넘으면 막는" 값이다 — 자동 충전 · 초과 과금 · 나중 청구는 없다. 워크스페이스의 한도는 요금제 권리
# (ai.trial_responses · ai.monthly_responses · ai.window_responses)와 운영자 보충(npm run ai:grant)이 정한다.
# 시험 · CI · e2e 는 이 값을 쓰지 않는다 — 가짜 공급자를 스스로 띄우고 세 줄을 덮어쓴다.
#
# 기본 — Groq 무료 등급
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_API_KEY=""
AI_MODEL="openai/gpt-oss-120b"
# 다른 무료 등급(같은 OpenAI 호환 주소 — 주소 · 키 · 모델만 바꾼다)
# AI_BASE_URL="https://openrouter.ai/api/v1"                                   # OpenRouter(무료 모델은 이름이 :free 로 끝난다)
# AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"       # Gemini
#
# 두 상한의 기본값은 Groq 무료 등급(openai/gpt-oss-120b)의 실제 한도에 맞췄다 — 분당 8,000 토큰(입력 + 출력 합) · 하루 1,000 요청
# (자정에 차는 것이 아니라 86.4초마다 하나씩 다시 차는 양동이). 한국어는 글자 하나가 토큰 하나 안팎으로 빽빽하므로 응답 하나가
# 6,000자 + 1,500 토큰 = 8,000 토큰 아래에 들게 했다. 공급자가 그래도 429 를 주면 화면은 "AI 서비스가 잠시 바쁩니다 — N초 뒤 다시"
# (ai_busy) 를 보이고 그 응답은 셈에서 빠진다(받은 답이 없다).
# 한 응답의 출력 상한(토큰) — 공급자에 max_tokens 로 보내고, 넘으면 스트림을 끊고 받은 데까지 남긴다.
# AI_MAX_OUTPUT_TOKENS=1500
# 보내는 글의 상한(메시지 글자 합) — 넘으면 보내지 않는다(input_too_long).
# AI_MAX_INPUT_CHARS=6000
# 앱 전체의 UTC 하루 응답 수 — 공급자의 하루 요청 한도(1,000)보다 낮게(모든 워크스페이스가 한 무료 한도를 나눠 쓴다 · 0 이면 닫는다).
# AI_DAILY_CAP=900
# 한 응답의 전체 시간 상한(ms).
# AI_TIMEOUT_MS=60000
# 0 이면 stream_options.include_usage 를 보내지 않는다(받지 않는 공급자 — 그때는 토큰 수가 비어 기록된다).
# AI_STREAM_USAGE=1

# ── 파일 스토리지 (Phase 1~2) ──────────────────────────────────
# MinIO 는 쓰지 않는다 — AGPLv3 인 데다 2026-04-25 리포지토리 아카이브(개발 중단).
# 기본은 Cloudflare R2, 자체 호스팅이 필요하면 SeaweedFS(Apache-2.0).
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── 파일 스토리지 ──────────────────────────────────────────────
# 업로드한 파일을 둘 폴더. 로컬 드라이버 전용이고 기본값은 var/uploads 다.
# 여러 서버로 늘리면 이 드라이버로는 안 된다 — R2(S3 호환) 드라이버가 필요하다.
# FILE_STORAGE_DIR=var/uploads
