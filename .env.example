# 이 파일을 .env 로 복사해서 쓴다.  cp .env.example .env
# .env 는 gitignore 대상이다. 절대 커밋하지 않는다.

# ── 데이터베이스 ────────────────────────────────────────────────
# docker-compose.yml 의 db 서비스 기본값과 맞춰져 있다.
DATABASE_URL="postgresql://notion:notion_dev_only@localhost:5432/notion"

# ── 캐시 (Valkey) ──────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── 앱 ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 세션 쿠키 서명 키. 개발용 아무 값이나 두지 말고 아래로 생성해서 넣는다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# ── LLM (Phase 2) ──────────────────────────────────────────────
# CLAUDE.md 절대 제약 2: 토큰은 하드 캡. 초과 시 자동 결제 없이 차단한다.
#
# 아래 한도는 "넘으면 막는" 값이지 "넘으면 청구하는" 값이 아니다.
# 자동 충전·후불 초과 청구는 설계상 금지다.
#
# LLM_ENABLED=false 이면 AI 기능 경로 자체가 열리지 않는다. Phase 2 전까지 기본값.
LLM_ENABLED="false"
LLM_PROVIDER=""
LLM_API_KEY=""

# 워크스페이스당 월 토큰 상한. 도달하면 요청을 거부한다.
LLM_MONTHLY_TOKEN_CAP="0"
# 단일 요청 상한. 스트리밍 중 넘으면 중단하고 부분 응답을 저장한다.
LLM_REQUEST_TOKEN_CAP="0"

# ── 파일 스토리지 (Phase 1~2) ──────────────────────────────────
# MinIO 는 쓰지 않는다 — AGPLv3 인 데다 2026-04-25 리포지토리 아카이브(개발 중단).
# 기본은 Cloudflare R2, 자체 호스팅이 필요하면 SeaweedFS(Apache-2.0).
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
